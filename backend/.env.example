# Copy this file to backend/.env and fill in your values.
# NEVER put your real key in this file — it is committed to the repository.

# --- LLM provider (NVIDIA Build / NIM) ---
# API key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model ID on NIM (OpenAI-compatible). NIM retires models over time — verify
# the one you pick is live AND enabled for your account at https://build.nvidia.com.
# A model appearing in GET /models does not guarantee your account can call it.
#   nvidia/nemotron-3-ultra-550b-a55b   (verified 2026-11-06: fast ping, clean JSON;
#                                        reasoning model — needs generous max_tokens)
#   mistralai/mistral-large-4-1t-a52b    (works but very slow, ~50s for a tiny prompt)
#   openai/gpt-oss-20b                  (was reachable 2026-10; re-verify before use)
#   deepseek-ai/deepseek-v4.1-flash     (worked 2026-10 but ~7x slower — reasoning model)
# Dead as of 2026-11-06: moonshotai/kimi-k3 (410), nvidia/nemotron-3-super-120b-a12b (404),
# moonshotai/kimi-k2.6 (404 for this account), z-ai/glm-5.3-flash (timeouts).
# Swap without code changes — the provider is abstracted.
NIM_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b

# OpenAI-compatible base URL for NVIDIA NIM
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Server (optional) ---
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=["http://localhost:3000"]

# --- Content (optional) ---
# Path (absolute, or relative to backend/) containing the lectures/ folder
# CONTENT_DIR=../content
